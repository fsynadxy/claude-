<?xml version="1.0" encoding="utf-8"?>
<!-- Voice models are large and can be downloaded again; keep them out of backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tts/" />
        <exclude domain="file" path="voices/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tts/" />
        <exclude domain="file" path="voices/" />
    </device-transfer>
</data-extraction-rules>
